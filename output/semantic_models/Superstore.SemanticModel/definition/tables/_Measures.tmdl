table _Measures
	lineageTag: 94180c93-a8dc-48ce-8308-0a03ab396f8c

	column Value
		dataType: string
		isHidden
		lineageTag: a3f7d2c4-9392-47b9-ae6f-33b0ce094f0c
		summarizeBy: none
		sourceColumn: [Value]
		type: calculatedTableColumn

	/// Migrated from a Tableau calculation.
	measure 'Total Sales' = SUM('Orders'[Sales_Amount])
		lineageTag: 14c94695-41d7-48c3-9f88-a4698f73271f
		annotation TableauFormula = SUM([Sales])
		annotation TranslatedBy = deterministic
		annotation SummarizationSetBy = Automatic

	/// Migrated from a Tableau calculation.
	measure 'Profit Ratio' = DIVIDE(SUM('Orders'[Profit]), SUM('Orders'[Sales_Amount]))
		lineageTag: 430b7ad0-c065-4902-adc0-2950b5f94884
		annotation TableauFormula = SUM([Profit]) / SUM([Sales])
		annotation TranslatedBy = deterministic
		annotation SummarizationSetBy = Automatic

	/// Untranslated Tableau calculation -- needs manual review (inert placeholder returning 0).
	measure 'Running Sales' = 0
		lineageTag: fac12353-e2e8-402c-91bc-76ec94290440
		annotation TableauFormula = RUNNING_SUM(SUM([Sales]))
		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = Row("Value", BLANK())

	annotation PBI_Id = _Measures

