# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Scratch conversion runs (regenerable). The committed `output/` is the
# README's canonical proof bundle; these variants are local experiments.
# `out/` is what the README's quick start writes to, so every first-run user
# generates one -- it must never show up as something git offers to commit.
out/
out-*/
output-hard/
output-real/
output-tablecalc/
output-estate/
output-newuser/
output-directlake/
my-test-estate/
my-test-output/
my-test-votd/

# Local DirectLake conversion inputs (customer workbooks staged for a run)
_dl_in/
_votd_in/

# Your own Tableau workbooks dropped in for a run (never committed). The folder
# and its README stay tracked; any workbook/datasource artifacts inside do not.
workbooks/*
!workbooks/README.md

# Third-party Tableau workbooks are NEVER committed to this repo.
#
# Files downloaded from Tableau Public, Tableau Cloud/Server or a customer tenant
# belong to whoever authored them. Bundling them here would be redistribution we
# have no licence for, regardless of the fact that they are publicly viewable. The
# folders and their READMEs stay tracked so the docs and the -Source paths still
# work; the workbook binaries themselves must be fetched by each user.
#
# Only workbooks generated by this repo's own synthetic fixtures may be committed
# (sample/, sample-hard/, sample-tablecalc/) -- those we authored.
sample-workbooks/*
!sample-workbooks/README.md
sample-real/
customer-estate/

# Root-level scratch scripts / probes / dumps (regenerable, not part of the engine)
/_*.py
/_*.jsonl

# Demo-source originals (backups of downloaded workbooks before repoint)
_estate_originals/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
